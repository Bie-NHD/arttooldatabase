      name="twitter:description"
      content="Comprehensive directory of digital and traditional art tools for artists."
    />
    <meta
      property="og:image"
      content="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎨</text></svg>"
    />
  </head>
  <body>
    <slot />
  </body>
  <footer class="bg-primary flex items-center justify-center">
    <p class="min-w-min p-8">
      Icons by <a href="https://lucide.dev" target="_blank" rel="noopener noreferrer" class="link"
        >LucideIcons</a
      > and <a href="https://simpleicons.org" target="_blank" rel="noopener noreferrer" class="link"
        >SimpleIcons</a
      > • Built with <a
        href="https://astro.build"
        target="_blank"
        rel="noopener noreferrer"
        class="link">Astro</a
      >.•
