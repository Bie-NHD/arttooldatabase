<!doctype html>
<html lang="en" data-theme="cupcake">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎨</text></svg>"
    />
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <meta name="generator" content={Astro.generator} />
    <title>arttooldatabase | Directory of tools for artists</title>
    <meta
      name="description"
      content="Comprehensive directory of digital and traditional art tools for artists. Discover software, brushes, and resources to enhance your creative workflow."
    />
    <meta
      name="keywords"
      content="art tools, digital art, digital painting, art software, artist resources, creative tools, drawing software, design tools"
    />
    <meta name="author" content="arttooldatabase" />
    <meta property="og:title" content="arttooldatabase | Directory of tools for artists" />
    <meta
      property="og:description"
      content="Comprehensive directory of digital and traditional art tools for artists."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
