---
import { getCollection } from "astro:content";

import Layout from "../layouts/Layout.astro";

import ItemComponent from "../components/ItemComponent.astro";

import FilterBar from "../components/FilterBar.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.

const items = await getCollection("items");
---

<Layout>
  <FilterBar />
  {/** ---------- Item list ---------- */}
  <section class="p-8 md:m-16" aria-label="Item list">
    <ul
      class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3"
      id="item-grid-container"
    >
      {items.map((item) => <ItemComponent item={item.data} />)}
    </ul>
  </section>
  <section class="bg-secondary p-8">
    <h2 class="mb-4 text-xl font-bold" id="faq">Frequently Asked Questions</h2>
    <details
      class="bg-base-100/50 border-secondary collapse mb-1 border"
      name="my-accordion-det-1"
      open
    >
      <summary class="collapse-title font-semibold"
        >What is this website about?</summary
      >
      <div class="collapse-content text-sm">
        This website is a database of art tools, where you can find various
        tools for digital art creation, along with their descriptions,
        platforms, licenses, and links to their websites.
      </div>
    </details>
    <details
      class="bg-base-100/50 border-secondary collapse mb-1 border"
      name="my-accordion-det-1"
      open
    >
      <summary class="collapse-title font-semibold"
        >How can I contribute to this website?</summary
      >
      <div class="collapse-content text-sm">
        You can contribute by submitting new art tools, updating existing tool
        information, or providing feedback. Please check the "Contributing"
        section on our website for more details on how to get involved.
      </div>
    </details>
    <details
      class="bg-base-100/50 border-secondary collapse border"
      name="my-accordion-det-1"
      open
    >
      <summary class="collapse-title font-semibold"
        >How do I update my profile information?</summary
      >
      <div class="collapse-content text-sm">
        Go to "My Account" settings and select "Edit Profile" to make changes.
      </div>
    </details>
  </section>
</Layout>
